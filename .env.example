# Không điền giá trị thật vào file này. Lấy giá trị thật bằng:
#   vercel env pull .env.local --yes
# (Vercel tự tạo các biến này khi gắn Supabase vào project.)

# Dùng trong app (an toàn để lộ ra trình duyệt)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chỉ dùng cho Supabase CLI ở máy local (migration, sinh type). Không dùng trong code app.
POSTGRES_URL_NON_POOLING=
